		"todo-list",
		"ui component"
	],
	"homepage": "https://svar.dev/svelte/core/",
	"bugs": {
		"url": "https://forum.svar.dev"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/svar-widgets/tasklist.git"
	},
	"files": [
